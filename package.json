{
  "private": true,
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "lint-staged": {
    "*.ts*": [
      "eslint --fix"
    ]
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "browserslist": [
    "extends @anansi/browserslist-config"
  ],
  "scripts": {
    "postinstall": "husky && yarn workspace \"@anansi/webpack-config\" run build",
    "changelog": "run lerna version",
    "release": "yarn workspaces foreach -Wtiv --no-private npm publish --access public --tolerate-republish",
    "build": "yarn workspaces foreach -Wt --no-private run build",
    "dev": "yarn workspaces foreach -Wpi --no-private run dev",
    "lint": "eslint --quiet packages",
    "test:type": "yarn workspaces foreach -Wpv run test:type",
    "format": "eslint --fix packages",
    "build:types": "tsc --build",
    "build:pkg": "run build:types && yarn workspace \"@anansi/webpack-config\" run build && yarn workspaces foreach -Wptv --no-private --exclude \"@anansi/webpack-config\" run build",
    "build:clean": "yarn workspaces foreach -Wpi --no-private run build:clean",
    "build:sizecompare": "yarn workspace example-typescript build:clean && yarn workspace example-typescript build --env nohash",
    "build:agent-rules": "node scripts/agent-rules.mjs",
    "prepack": "run build:pkg",
    "version": "yarn constraints --fix && yarn install --mode=update-lockfile && git add examples/*/package.json",
    "devtest:ci": "yarn workspaces foreach -Wv --include example-react-18 --include example-linaria run devtest:ci",
    "g:babel": "cd $INIT_CWD && babel --root-mode upward src --source-maps inline --extensions '.ts,.tsx,.cts,.js' --ignore '**/__tests__/**' --ignore '**/*.d.ts'",
    "g:webpack": "cd $INIT_CWD && webpack",
    "g:rimraf": "cd $INIT_CWD && rimraf",
    "g:clean": "cd $INIT_CWD && rimraf lib dist ts3.4 legacy *.tsbuildinfo",
    "g:tsc": "cd $INIT_CWD && tsc",
    "g:test": "cd $INIT_CWD && jest",
    "g:lint": "cd $INIT_CWD && eslint",
    "g:devtest": "cd $INIT_CWD && WAIT_ON_TIMEOUT=40000 start-server-and-test"
  },
  "devDependencies": {
    "@anansi/babel-preset": "workspace:*",
    "@anansi/browserslist-config": "workspace:*",
    "@anansi/eslint-plugin": "workspace:*",
    "@babel/cli": "8.0.6",
    "@babel/core": "8.0.7",
    "@babel/runtime-corejs3": "^8.0.0",
    "@commitlint/cli": "19.8.1",
    "@commitlint/config-conventional": "19.8.1",
    "@lerna-lite/cli": "4.11.5",
    "@types/node": "^24.0.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "babel-loader": "10.1.1",
    "babel-plugin-module-resolver": "5.0.3",
    "babel-plugin-root-import": "6.6.0",
    "conventional-changelog-anansi": "0.3.1",
    "conventional-changelog-conventionalcommits": "6.1.0",
    "eslint": "9.39.5",
    "globals": "^17.0.0",
    "husky": "9.1.7",
    "jest": "^30.0.0",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "rimraf": "^6.0.0",
    "start-server-and-test": "^3.0.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "webpack": "5.111.1",
    "webpack-cli": "7.2.3",
    "webpack-dev-server": "6.0.0"
  },
  "resolutions": {
    "storybook": "10.6.1",
    "@storybook/builder-webpack5/webpack": "5.111.1",
    "@storybook/preset-react-webpack/webpack": "5.111.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "normalize-url": "^6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "@conventional-changelog/git-client": "2.7.0",
    "@storybook/builder-webpack5/webpack-dev-middleware": "^8.0.0",
    "serve/compression": "^1.8.2",
    "write-package/deepmerge-ts": "^8.0.2",
    "@ant-design/pro-layout/path-to-regexp": "^8.4.0"
  },
  "dependencies": {
    "@lerna-lite/publish": "^4.0.0",
    "@lerna-lite/version": "^4.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "packageManager": "yarn@4.18.1"
}
