{
  "name": "example-linaria",
  "version": "9.0.47",
  "private": true,
  "scripts": {
    "start": "webpack serve --mode=development",
    "start:prod": "serve ./dist",
    "build": "webpack --mode=production",
    "build:server": "webpack --mode=production --target=node",
    "build:clean": "rm -rf dist && rm -rf server_assets",
    "build:analyze": "webpack --mode=production --env analyze",
    "build:profile": "webpack --mode=production --env profile",
    "pkgcheck": "webpack --env check=nobuild",
    "test": "echo \"Error: no test specified\" && exit 1",
    "test:ci": "echo \"Error: no test specified\"",
    "test:type": "tsc --noEmit",
    "devtest:validate": "exit 0",
    "devtest:ci": "yarn g:devtest start http://localhost:8080 devtest:validate"
  },
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "devDependencies": {
    "@anansi/babel-preset": "^7.0.0",
    "@anansi/browserslist-config": "^1.7.6",
    "@anansi/eslint-plugin": "^2.0.0",
    "@anansi/webpack-config": "^22.0.0",
    "@babel/core": "^8.0.0",
    "@types/eslint": "^9.0.0",
    "@types/node": "^26.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/react-router-dom": "5.3.3",
    "babel-loader": "10.1.1",
    "eslint": "^10.0.0",
    "prettier": "^3.0.0",
    "react-refresh": "0.19.0",
    "serve": "14.2.6",
    "webpack": "5.111.1",
    "webpack-cli": "^7.2.3",
    "webpack-dev-server": "^6.0.0"
  },
  "dependencies": {
    "@babel/plugin-transform-modules-commonjs": "8.0.1",
    "@babel/runtime-corejs3": "8.0.7",
    "@linaria/core": "8.2.0",
    "@linaria/react": "8.2.0",
    "classnames": "2.5.1",
    "core-js": "3.50.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "browserslist": [
    "extends @anansi/browserslist-config"
  ],
  "peerDependencies": {
    "@types/react": "^17.0.40 || ^18.0.0 || ^19.0.0",
    "@types/react-dom": "^17.0.40 || ^18.0.0 || ^19.0.0"
  }
